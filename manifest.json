{
  "manifest_version": 3,
  "name": "Netio (dev)",
  "version": "1.2.0",
  "description": "Calculadora de comisiones, ganancias y precios para vendedores de Mercado Libre México.",
  "default_locale": "es_419",
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://extensionpay.com/*"
  ],
  "action": {
    "default_title": "Netio — Tablero de Ganancias"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://articulo.mercadolibre.com.mx/*",
        "https://www.mercadolibre.com.mx/*",
        "https://listado.mercadolibre.com.mx/*"
      ],
      "js": [
        "src/config/branding.js",
        "src/config/i18n.js",
        "src/fees/fee-table.js",
        "src/fees/shipping-table.js",
        "src/fees/calculator.js",
        "src/fees/fee-source.js",
        "src/pro/gate.js",
        "src/content/format.js",
        "src/content/upsell.js",
        "src/content/history.js",
        "src/content/page-data.js",
        "src/content/card.js",
        "src/content/quickview.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://extensionpay.com/*"
      ],
      "js": [
        "src/vendor/extpay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/icons/*.png"
      ],
      "matches": [
        "https://*.mercadolibre.com.mx/*"
      ]
    }
  ]
}
